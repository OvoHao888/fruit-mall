# ==========================================================================
#  本地私密配置示例
#
#  用法：把本文件复制为同目录下的 application-local.properties，填入真实值。
#  application-local.properties 已在 .gitignore 中，不会被提交。
# ==========================================================================

# ---------------- 数据库 ----------------
DB_USERNAME=root
DB_PASSWORD=你的数据库口令

# ---------------- 邮件 ----------------
# 注意：QQ 邮箱这里要填「SMTP 授权码」，不是邮箱登录密码
MAIL_USERNAME=你的邮箱@qq.com
MAIL_PASSWORD=你的SMTP授权码

# ---------------- 大模型（智能导购）----------------
# base-url 与 model 在 application.properties 里已有默认值，换服务时再改
# AI_BASE_URL=https://api.siliconflow.cn
# AI_MODEL=deepseek-ai/DeepSeek-V3
AI_API_KEY=你的大模型APIKey

# ---------------- 其它 ----------------
# SECURITY_USER=admin
# SECURITY_PASSWORD=改成一个强口令
# USER_DEFAULT_PASSWORD=123456
